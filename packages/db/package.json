{
  "name": "@buscahogar/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Esquema de base de datos, cliente ORM y migraciones",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/public.d.ts",
      "default": "./dist/e2e/public.js"
    },
    "./test-database": {
      "types": "./dist/test-database.d.ts",
      "default": "./dist/test-database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:blocking": "vitest run -c vitest.blocking.config.ts",
    "test:consolidation": "vitest run -c vitest.consolidation.config.ts",
    "test:detail": "vitest run -c vitest.detail.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "seed": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/seed.js",
    "seed:e2e": "tsc -p tsconfig.build.json && node dist/e2e/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buscahogar/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@buscahogar/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
