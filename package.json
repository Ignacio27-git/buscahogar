{
  "name": "buscahogar",
  "version": "0.0.1",
  "private": true,
  "description": "Agregador inmobiliario — plataforma que normaliza ofertas de varias fuentes",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:web": "pnpm --filter \"./packages/*\" build && pnpm --filter @buscahogar/web run dev",
    "dev:ingestion": "pnpm --filter \"./packages/*\" build && pnpm --filter @buscahogar/ingestion run dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter \"./packages/*\" build && pnpm -r lint",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
    "test": "pnpm --filter \"./packages/*\" build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @buscahogar/db run generate",
    "db:migrate": "pnpm --filter @buscahogar/db run migrate",
    "db:seed": "pnpm --filter @buscahogar/db run seed"
  },
  "devDependencies": {
    "@buscahogar/config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
