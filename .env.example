# =============================================================================
# Agregador inmobiliario - plantilla de variables de entorno
# =============================================================================
#
# Copia este fichero al fichero de entorno local (sin extension .example) y
# rellena los valores. Ese fichero esta en .gitignore y NUNCA se sube al
# control de versiones.
#
# Solo nombres de variable y placeholders: este fichero no contiene secretos.
#
# -----------------------------------------------------------------------------
# CREDENCIALES: SOLO PARA apps/ingestion
# -----------------------------------------------------------------------------
# Las credenciales de fuentes externas (Idealista, etc.) las lee EXCLUSIVAMENTE
# el worker apps/ingestion. NUNCA deben:
#   - usarse en apps/web,
#   - exponerse en una variable con prefijo NEXT_PUBLIC_,
#   - aparecer en logs sin sanitizar.
# apps/web y apps/ingestion se comunican solo por base de datos.
# -----------------------------------------------------------------------------


# --- Base de datos: PostgreSQL + PostGIS -------------------------------------
# Cadena de conexion que usan packages/db, apps/web (lectura de busqueda) y
# apps/ingestion (escritura del pipeline).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/buscahogar

# Credenciales del contenedor de Postgres (docker-compose, paso 1.2).
POSTGRES_USER=buscahogar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=buscahogar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# --- Fuente: API de Idealista (SOLO apps/ingestion) -------------------------
# Credenciales OAuth de la API. Cuota mensual limitada: ver reglas de cuota.
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
IDEALISTA_API_BASE_URL=https://api.idealista.com


# --- Presupuesto de cuota y topes de barrido (SOLO apps/ingestion) ----------
# Corte explicito del consumo de la API. Un bucle sin tope agota la cuota del mes.

# Presupuesto diario de peticiones a la API de la fuente.
INGESTION_DAILY_REQUEST_BUDGET=1000

# Maximo de peticiones por barrido de una zona (corte de paginacion).
INGESTION_MAX_REQUESTS_PER_SWEEP=10

# Tope de zonas nuevas que se pueden cubrir por dia.
INGESTION_MAX_NEW_ZONES_PER_DAY=5

# Tope de zonas nuevas que se pueden cubrir en una misma sesion/ejecucion.
INGESTION_MAX_NEW_ZONES_PER_SESSION=2


# --- apps/web ---------------------------------------------------------------
# Solo variables NEXT_PUBLIC_* que NO sean secretas (nunca credenciales de
# fuentes). De momento apps/web no necesita ninguna.
