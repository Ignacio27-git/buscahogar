{
  "name": "@buscahogar/ingestion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Worker de ingesta: barridos, normalización, deduplicación",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --env-file=../../.env --import tsx scripts/probe-idealista.ts",
    "probe:homes": "node --env-file=../../.env --import tsx scripts/probe-idealista.ts --profile homes",
    "probe:premises": "node --env-file=../../.env --import tsx scripts/probe-idealista.ts --profile premises",
    "probe:analyse": "node --import tsx scripts/probe-idealista.ts --analyse",
    "probe:adids": "node --env-file=../../.env --import tsx scripts/probe-idealista-adids.ts",
    "sweep": "node --env-file=../../.env --import tsx scripts/sweep-zone.ts",
    "calibrate": "node --env-file=../../.env --import tsx scripts/calibrate-blocking.ts",
    "compare-strategies": "node --import tsx scripts/compare-dedup-strategies.ts",
    "reprocess": "node --env-file=../../.env --import tsx scripts/reprocess-dedup.ts",
    "worker": "node --env-file=../../.env --import tsx scripts/coverage-worker.ts",
    "backfill-thumbnails": "node --env-file=../../.env --import tsx scripts/backfill-thumbnails.ts",
    "gen-corpus": "node --env-file=../../.env --import tsx scripts/generate-search-corpus.ts",
    "bench-search": "node --env-file=../../.env --import tsx scripts/bench-search.ts",
    "bench-report": "node --import tsx scripts/render-bench-report.ts"
  },
  "dependencies": {
    "@buscahogar/core": "workspace:*",
    "@buscahogar/db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.11.1",
    "pg": "8.23.0",
    "sharp": "0.34.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@buscahogar/config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
